// Competitive 10-man config. Rationale for every line:
// ReHLDS/docs/competitive-server-config.md
hostname "ReHLDS competitive lab"

// ---- Rates ----
// MAX_RATE is 100000 (engine/net.h:108). sv_maxupdaterate is THE critical one:
// the server rewinds by max(client ex_interp, 1/updaterate), so a default of 30
// would override ex_interp 0.01 and rewind 33.3ms instead of 10ms.
sv_maxrate              100000
sv_minrate              25000
sv_maxupdaterate        102
sv_minupdaterate        60
sv_lan_rate             100000

// ---- Lag compensation ----
sv_unlag                1
sv_maxunlag             0.5
sv_unlagpush            0.0
sv_unlagsamples         1
sv_clienttrace          1

// ---- Match ----
mp_autoteambalance      0
mp_limitteams           0
mp_timelimit            0
mp_freezetime           5
mp_roundtime            9
mp_friendlyfire         1
sv_pausable             0
sv_cheats               0
sv_allowupload          0
sv_allowdownload        0

// ---- Bots as lag-comp victims ----
bot_join_after_player   0
bot_quota_mode          normal
bot_quota               9
bot_difficulty          2

// ---- Instrumentation on from the start ----
sv_rehlds_perf_frame    1
sv_rehlds_perf_hitreg   1
